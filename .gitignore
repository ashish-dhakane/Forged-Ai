# =========================================================
# ForgeAI - Root Git Ignore
# =========================================================

# -------------------------
# OS / Editor
# -------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Node / Next.js Frontend
# -------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/coverage/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Next.js generated files
# -------------------------
frontend/.vercel/

# -------------------------
# Java / Spring Boot Backend
# -------------------------
backend/target/
backend/.mvn/timing.properties

# Maven generated files
**/target/
**/*.class

# Spring Boot logs
*.log

# -------------------------
# Database / Local Data
# -------------------------
*.db
*.sqlite
*.sqlite3

# H2 database files
*.mv.db
*.trace.db

# -------------------------
# Build / Temporary files
# -------------------------
*.tmp
*.temp
*.cache

# -------------------------
# Logs
# -------------------------
logs/
*.log

# -------------------------
# Docker
# -------------------------
.docker/
docker-data/

# -------------------------
# Generated reports / coverage
# -------------------------
coverage/
reports/

# -------------------------
# AI / Local model files
# -------------------------
*.bin
*.gguf
*.safetensors

# -------------------------
# Uploads / User generated files
# -------------------------
uploads/
backend/uploads/
frontend/uploads/

# -------------------------
# Secrets / Keys / Certificates
# -------------------------
*.pem
*.key
*.crt
*.p12
*.jks

# -------------------------
# Local configuration
# -------------------------
application-local.properties
application-local.yml
application-local.yaml

# -------------------------
# OS temporary files
# -------------------------
*.bak
*.orig
*~